# PostgreSQL connection (Docker'da calisan postgres icin)
DATABASE_URL=postgresql+psycopg2://neuroscanai:neuroscan_dev_pass@localhost:5432/neuroscanai

# JWT secret — production'da `openssl rand -hex 32` ile uret
JWT_SECRET=change_me_to_a_long_random_string_in_production_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings
# Production'da SECURE=true (HTTPS gerekli) yapilmali
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# File upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Model
MODEL_PATH=models/ResNet50V2_neuroscan.keras
CLASSES_PATH=models/ResNet50V2_neuroscan_classes.json

# CORS
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
